# Cursor Background Agent API key
CURSOR_API_KEY=

# Git repo URLs
WELCOMEPAGE_API_REPO_URL=git@github.com:your-org/welcomepage-api.git
WELCOMEPAGE_FRONTEND_REPO_URL=git@github.com:your-org/welcomepage-prompts.git

# Base branch to create feature branches from (optional, defaults to "main")
# WELCOMEPAGE_BASE_BRANCH=main

# Working directory for cloned repos (optional, defaults to ./agent-work)
# WELCOMEPAGE_WORK_DIR=./agent-work

# Vercel deployment credentials
# Get your token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Your Vercel team/org ID (Settings -> General -> "Your ID")
VERCEL_ORG_ID=
# Project IDs from each Vercel project (Settings -> General -> "Project ID")
VERCEL_API_PROJECT_ID=
VERCEL_FRONTEND_PROJECT_ID=
